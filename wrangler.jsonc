{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tldr-lectures",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    { "pattern": "tldr.bruol.me", "custom_domain": true }
  ],
  "assets": {
    "directory": "./cloudflare/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/search", "/search/*", "/download/*"]
  }
}
